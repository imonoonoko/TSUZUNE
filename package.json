{
  "name": "tsuzune",
  "version": "0.5.0",
  "description": "書いて、つないで、あとで尋ねる。ローカルMarkdownとWikiリンクのWindowsメモ帳。",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Im_onoko",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:production": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "dogfood:m5": "node scripts/build-m5-dogfood.mjs",
    "capture:graph:gp1": "electron scripts/capture-graph-gp1.mjs",
    "capture:graph:gp6:obsidian": "node scripts/capture-graph-gp6-obsidian.mjs",
    "capture:graph:gp6:tsuzune": "node scripts/capture-graph-gp6-tsuzune.mjs",
    "capture:graph:gp6:working-tree": "npm run build && electron scripts/capture-graph-gp6-working-tree.mjs",
    "capture:graph:gp0-3b:obsidian": "node scripts/probe-obsidian-graph-search-persistence.mjs",
    "capture:graph:gp0-3b:tsuzune": "npm run build && node scripts/capture-graph-gp0-3b-search-restart.mjs",
    "capture:graph:gp0-camera:obsidian": "node scripts/probe-obsidian-graph-search-persistence.mjs --camera",
    "capture:graph:gp0-camera:tsuzune": "npm run build && node scripts/capture-graph-gp0-3b-search-restart.mjs --camera",
    "report:graph:gp0-camera": "node scripts/build-graph-gp0-camera-report.mjs",
    "capture:graph:gp0-node-drag:obsidian": "node scripts/probe-obsidian-graph-search-persistence.mjs --node-drag",
    "capture:graph:gp0-node-drag:tsuzune": "npm run build && node scripts/capture-graph-gp0-3b-search-restart.mjs --node-drag",
    "report:graph:gp0-node-drag": "node scripts/build-graph-gp0-node-drag-report.mjs",
    "capture:optimization-ui": "electron scripts/capture-optimization-ui.mjs",
    "measure:vault:large": "npm run build && node scripts/run-large-vault-performance.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:chatgpt-export": "node scripts/build-chatgpt-export-preview.mjs",
    "preview:chatgpt-export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-chatgpt-export.ps1",
    "check:mcp": "npm run build:mcp && node scripts/check-mcp.mjs",
    "mcp": "node out/mcp/server.js",
    "mcp:register": "npm run build:mcp && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-codex-mcp.ps1",
    "mcp:unregister": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unregister-codex-mcp.ps1",
    "build": "npm run typecheck && electron-vite build && npm run build:mcp",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "check:packaged": "node scripts/check-packaged-startup.mjs",
    "check:installer": "node scripts/check-installer.mjs",
    "production:update": "node scripts/update-production.mjs",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "chokidar": "5.0.0",
    "codemirror": "6.0.2",
    "d3-force": "3.0.0",
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "jp.tsuzune.app",
    "productName": "TSUZUNE",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "imonoonoko",
        "repo": "TSUZUNE",
        "private": true,
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/renderer/assets/tsuzune-woven-loop.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "TSUZUNE",
      "artifactName": "TSUZUNE-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "TSUZUNE"
    }
  }
}
