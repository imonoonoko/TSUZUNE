{
  "manifest_version": 3,
  "name": "TSUZUNE Browser Clipper",
  "version": "0.2.2",
  "description": "Clip ordinary pages and YouTube videos to local TSUZUNE.",
  "key": "",
  "action": { "default_popup": "popup.html" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:27193/*"]
}
